@* The interactive playground island: rendered in the browser (WebAssembly) inside the
   static-SSR /playground page (Components/Pages/Playground.razor in the host). Kept
   non-routable so the host owns the /playground route and emits it statically; this
   component just supplies the in-browser interactivity — it compiles the utility classes
   you type to CSS with the real MonorailCss engine, live, entirely client-side.

   Ported from tests/TryMonorail. The chrome is restyled to the docs colour scheme
   (base/primary map to the frosted/sanibel palettes via the host's /styles.css) and laid out
   full-height like the Beck playground; the user's own markup, by contrast, is compiled by a
   stock CssFramework, so the docs palette never leaks into their output. *@
@rendermode InteractiveWebAssembly
@inject IJSRuntime Js
@implements IAsyncDisposable
@using System.Text
@using Global = BlazorMonaco.Editor.Global

@* Pane grids. Every track is minmax(0, …) so a pane can always shrink below Monaco's current
   pixel width — with auto-sized tracks the editor holds its track open and spills over the
   preview when the window narrows. The splits are fr pairs in custom properties, written by
   the drag handles in /js/playground.js (--pg-main-a/b on .pg-main, --pg-left-a/b on .pg-left). *@
<style>
    .pg-main, .pg-left { display: grid; grid-template-columns: minmax(0, 1fr); }
    .pg-main { grid-template-rows: minmax(0, var(--pg-main-a, 1fr)) 5px minmax(0, var(--pg-main-b, 1fr)); }
    .pg-left { grid-template-rows: minmax(0, var(--pg-left-a, 1fr)) 5px minmax(0, var(--pg-left-b, 1fr)); }
    .pg-gutter { touch-action: none; cursor: row-resize; }
    @@media (min-width: 64rem) {
        .pg-main {
            grid-template-rows: minmax(0, 1fr);
            grid-template-columns: minmax(0, var(--pg-main-a, 1fr)) 5px minmax(0, var(--pg-main-b, 1fr));
        }
        .pg-gutter[data-pg-gutter="main"] { cursor: col-resize; }
    }
    body.pg-dragging { user-select: none; }
</style>

<div class="flex h-full flex-col bg-base-50 dark:bg-base-950">
    @* Panes: editor stack (HTML + generated CSS) on the left, live preview on the right.
       Stacks vertically below lg. Both splits are draggable (double-click a handle to reset). *@
    <div class="pg-main min-h-0 flex-1">

        @* Left column: HTML editor (top) over generated CSS (bottom). *@
        <div class="pg-left min-h-0 min-w-0">

            <div class="flex min-h-0 min-w-0 flex-col overflow-hidden">
                <header class="flex flex-none items-center gap-2 border-b border-base-200 bg-base-100 px-4 py-[7px] font-mono text-[11.5px] text-base-500 dark:border-base-800 dark:bg-base-900 dark:text-base-400">
                    <svg class="h-3.5 w-3.5 text-primary-600 dark:text-primary-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                    <span>index.html</span>
                    <button type="button" @onclick="ResetAsync"
                            class="ml-auto rounded-md border border-base-200 px-2 py-1 text-[11px] font-medium text-base-600 transition-colors hover:border-base-300 hover:text-base-900 dark:border-base-800 dark:text-base-400 dark:hover:border-base-700 dark:hover:text-base-50">
                        Reset
                    </button>
                </header>
                <div class="min-h-0 min-w-0 flex-auto">
                    <StandaloneCodeEditor @ref="_htmlEditor" Id="pg-html" CssClass="h-full w-full"
                                          ConstructionOptions="HtmlEditorOptions"
                                          OnDidInit="EditorInitAsync"
                                          OnDidChangeModelContent="ModelChangedAsync" />
                </div>
            </div>

            <div data-pg-gutter="left" role="separator" aria-orientation="horizontal" aria-label="Resize the HTML and CSS panes" tabindex="0"
                 class="pg-gutter bg-base-200 transition-colors hover:bg-primary-400 focus-visible:bg-primary-400 focus-visible:outline-none dark:bg-base-800 dark:hover:bg-primary-600 dark:focus-visible:bg-primary-600"></div>

            <div class="flex min-h-0 min-w-0 flex-col overflow-hidden">
                <header class="flex flex-none items-center gap-2 border-b border-base-200 bg-base-100 px-4 py-[7px] font-mono text-[11.5px] text-base-500 dark:border-base-800 dark:bg-base-900 dark:text-base-400">
                    <svg class="h-3.5 w-3.5 text-primary-600 dark:text-primary-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
                    <span>generated.css</span>
                </header>
                <div class="min-h-0 min-w-0 flex-auto">
                    <StandaloneCodeEditor @ref="_cssEditor" Id="pg-css" CssClass="h-full w-full"
                                          ConstructionOptions="CssViewerOptions" />
                </div>
            </div>
        </div>

        <div data-pg-gutter="main" role="separator" aria-orientation="vertical" aria-label="Resize the editors and the preview" tabindex="0"
             class="pg-gutter bg-base-200 transition-colors hover:bg-primary-400 focus-visible:bg-primary-400 focus-visible:outline-none dark:bg-base-800 dark:hover:bg-primary-600 dark:focus-visible:bg-primary-600"></div>

        @* Right column: sandboxed live preview. *@
        <div class="flex min-h-0 min-w-0 flex-col overflow-hidden">
            <header class="flex flex-none items-center gap-2 border-b border-base-200 bg-base-100 px-4 py-[7px] font-mono text-[11.5px] text-base-500 dark:border-base-800 dark:bg-base-900 dark:text-base-400">
                <span>preview</span>
                <span class="ml-auto inline-flex items-center gap-1.5 text-primary-700 dark:text-primary-400">
                    <span class="h-[7px] w-[7px] animate-pulse rounded-full bg-primary-600 dark:bg-primary-400"></span>live
                </span>
            </header>
            <div class="flex min-h-0 flex-1">
                <PreviewViewer @ref="_preview" />
            </div>
        </div>
    </div>

    @* Status bar. *@
    <div class="flex flex-none items-center gap-4 border-t border-base-200 bg-base-100 px-5 py-[7px] font-mono text-[11.5px] text-base-500 dark:border-base-800 dark:bg-base-900 dark:text-base-400">
        <span>@_classCount classes</span>
        <span>@FormatBytes(_cssBytes) css</span>
        <span class="ml-auto">Default theme · compiled live by MonorailCss</span>
    </div>
</div>

@code {
    private StandaloneCodeEditor _htmlEditor = null!;
    private StandaloneCodeEditor _cssEditor = null!;
    private PreviewViewer _preview = null!;

    // Two stock engines — `new CssFramework()` with no theme customisation, so what the user
    // sees (palette, generated theme variables, autocomplete) is exactly what they'd get out of
    // the box, not the docs site's own primary/accent/base scheme. One with preflight for the
    // isolated preview iframe (a clean reset), one without for the "generated CSS" pane, the
    // per-class hover and autocomplete.
    private readonly CssFramework _previewFramework = new();
    private readonly CssFramework _displayFramework = new(new CssFrameworkSettings { IncludePreflight = false });

    private readonly DebounceHelper _debouncer = new();
    private DotNetObjectReference<PlaygroundIsland>? _selfRef;

    private string _previousCss = string.Empty;
    private int _classCount;
    private int _cssBytes;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await RegisterHoverProviderAsync();
        await RegisterCompletionProviderAsync();
        _selfRef = DotNetObjectReference.Create(this);
        var theme = await Js.InvokeAsync<string>("monorailPlayground.observeTheme", _selfRef);
        await Global.SetTheme(Js, theme == "dark" ? "monorail-dark" : "monorail-light");
    }

    // Flip the editor themes when the docs light/dark toggle stamps/removes `.dark` on <html>.
    [JSInvokable]
    public async Task OnHostThemeChanged(string theme) =>
        await Global.SetTheme(Js, theme == "dark" ? "monorail-dark" : "monorail-light");

    private async Task EditorInitAsync()
    {
        await DefineThemesAsync();
        var dark = await Js.InvokeAsync<bool>("monorailPlayground.isDark");
        await Global.SetTheme(Js, dark ? "monorail-dark" : "monorail-light");

        // Seed the welcome document. SetValue raises OnDidChangeModelContent, which the
        // debounce collapses into the first compile; push once explicitly too so the preview
        // paints immediately rather than after the debounce window.
        await _htmlEditor.SetValue(InitialHtml);
        await UpdateViewAsync();
        await MarkAsync("pg:first-preview");

        // Start filling the autocomplete list now the playground has painted.
        EnsureClassNamesBuilding();
    }

    private async Task<bool> ModelChangedAsync() =>
        await _debouncer.DebounceAsync(async _ =>
        {
            await UpdateViewAsync();
            return true;
        }, 200);

    private async Task ResetAsync()
    {
        await _htmlEditor.SetValue(InitialHtml);
        await UpdateViewAsync();
    }

    private async Task UpdateViewAsync()
    {
        var html = await _htmlEditor.GetValue();
        var classAttributes = CssParser.GetCssClasses(html).ToArray();
        _classCount = classAttributes
            .SelectMany(a => a.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .Distinct()
            .Count();

        // Preview gets the preflighted CSS; the pane shows the utilities only.
        var previewCss = _previewFramework.Process(classAttributes);
        var displayCss = _displayFramework.Process(classAttributes);
        _cssBytes = Encoding.UTF8.GetByteCount(displayCss);

        if (_previousCss != displayCss)
        {
            await _cssEditor.SetValue(displayCss);
            _previousCss = displayCss;
        }

        await _preview.UpdateAsync(html, previewCss);
        StateHasChanged();
    }

    // ---- per-class CSS hover -------------------------------------------------
    // Hovering a utility class inside a class="…" attribute shows the CSS it compiles to.
    private async Task RegisterHoverProviderAsync()
    {
        await BlazorMonaco.Languages.Global.RegisterHoverProviderAsync(Js, "html", async (uri, position, _) =>
        {
            var model = await Global.GetModel(Js, uri);
            if (model == null)
            {
                return null;
            }

            // Hover positions name the character under the pointer, so a delimiter (the space
            // between two classes, the closing quote) means "not over a class".
            var token = await GetClassTokenAtPositionAsync(model, position);
            if (token is null
                || string.IsNullOrWhiteSpace(token.ClassName)
                || (token.CaretIndex < token.Line.Length && IsClassDelimiter(token.Line[token.CaretIndex])))
            {
                return null;
            }

            var css = CompileForDisplay(token.ClassName);
            if (css is null)
            {
                return null;
            }

            return new Hover
            {
                Contents = [new MarkdownString { Value = $"```css\n{css}\n```", SupportThemeIcons = false }],
                Range = token.ToRange(position.LineNumber),
            };
        });
    }

    // The class token around a caret inside a class="…" attribute: the run of non-delimiter
    // characters either side of it (so `hover:bg-red-500` is one token). Empty when the caret
    // sits between two classes or right after the opening quote. Shared by hover and completion.
    private sealed record ClassToken(string Line, int CaretIndex, int StartIndex, int EndIndex)
    {
        public string ClassName => Line[StartIndex..EndIndex];

        // What has been typed of the token so far — completion filters on this.
        public string TypedPrefix => Line[StartIndex..CaretIndex];

        // Monaco columns are 1-indexed and the end column is exclusive.
        public BlazorMonaco.Range ToRange(int lineNumber) => new()
        {
            StartLineNumber = lineNumber,
            EndLineNumber = lineNumber,
            StartColumn = StartIndex + 1,
            EndColumn = EndIndex + 1,
        };
    }

    private static bool IsClassDelimiter(char c) => c is ' ' or '\t' or '"' or '\'' or '<' or '>' or '\n' or '\r';

    private static async Task<ClassToken?> GetClassTokenAtPositionAsync(TextModel model, Position position)
    {
        var lineContent = await model.GetLineContent(position.LineNumber);
        if (string.IsNullOrEmpty(lineContent))
        {
            return null;
        }

        // Monaco columns are 1-indexed; convert to 0-indexed for string work.
        var cursorIndex = position.Column - 1;
        if (cursorIndex < 0 || cursorIndex > lineContent.Length)
        {
            return null;
        }

        // Only when the caret sits inside a class attribute.
        if (!CssParser.IsInCssClass(lineContent[..cursorIndex]))
        {
            return null;
        }

        var startIndex = cursorIndex;
        while (startIndex > 0 && !IsClassDelimiter(lineContent[startIndex - 1]))
        {
            startIndex--;
        }

        var endIndex = cursorIndex;
        while (endIndex < lineContent.Length && !IsClassDelimiter(lineContent[endIndex]))
        {
            endIndex++;
        }

        return new ClassToken(lineContent, cursorIndex, startIndex, endIndex);
    }

    // The lean `@layer utilities` CSS for one class (variants included), or null if it emits none.
    private string? CompileForDisplay(string className)
    {
        var css = ExtractLayerContent(_displayFramework.Process(className));
        return string.IsNullOrWhiteSpace(css) ? null : css;
    }

    // ---- utility-class autocomplete ------------------------------------------
    // Inside a class="…" attribute, suggests MonorailCss utility classes for the playground's
    // theme. The candidate list comes from CssFramework.GetSuggestedClassNames (static names plus
    // functional roots expanded over the theme, every one known to compile). Producing it means
    // compiling ~30k probes — seconds on the WASM interpreter — so it's built once, in the
    // background after the editor loads, in short time slices that keep the page responsive
    // (see BuildClassNamesAsync). Each request filters it in .NET by the typed prefix and sends
    // at most MaxCompletionItems across interop, marking the list incomplete when capped (or
    // while the build is still running) so Monaco asks again as you type. The CSS for an item is
    // compiled lazily, only when Monaco resolves the focused item, never for the whole list.
    private const int MaxCompletionItems = 150;

    // Longest stretch the background build holds the (single) WASM thread before yielding.
    private const int ClassNameBuildSliceMs = 12;

    // Space/quote open the list for a fresh class; '-' and ':' re-query because the HTML word
    // definition treats ':' as a separator (which would otherwise close the widget) and a new
    // segment narrows the prefix past the capped first page.
    private static readonly List<string> CompletionTriggerCharacters = [" ", "\"", "'", "-", ":"];

    // A small set of common variants, offered when the typed segment matches one; accepting
    // inserts `name:` and reopens the list for the utility part. Filtered to those the engine
    // actually knows (see Variants).
    private static readonly string[] CommonVariants =
    [
        "hover", "focus", "focus-visible", "focus-within", "active", "visited", "disabled",
        "first", "last", "odd", "even", "group-hover", "peer-focus", "placeholder", "before", "after",
        "dark", "sm", "md", "lg", "xl", "2xl", "motion-safe", "motion-reduce", "print",
    ];

    // Filled by BuildClassNamesAsync in the engine's order (grouped by root, natural within a
    // root). Requests that arrive mid-build filter whatever is there so far.
    private readonly List<string> _classNames = [];
    private bool _classNamesComplete;
    private Task? _classNamesBuild;
    private readonly CancellationTokenSource _disposeCts = new();

    private string[]? _variants;
    private readonly Dictionary<string, string?> _swatchCache = new(StringComparer.Ordinal);

    private void EnsureClassNamesBuilding() => _classNamesBuild ??= BuildClassNamesAsync(_disposeCts.Token);

    // The engine yields names lazily, compiling as it goes, so pull them in slices of
    // ClassNameBuildSliceMs and hand the thread back between slices — typing, hover and the
    // live recompile stay responsive while the list fills (a few seconds in all).
    private async Task BuildClassNamesAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Yield();
            var slice = System.Diagnostics.Stopwatch.StartNew();
            foreach (var name in _displayFramework.GetSuggestedClassNames())
            {
                _classNames.Add(name);
                if (slice.ElapsedMilliseconds >= ClassNameBuildSliceMs)
                {
                    await Task.Delay(1, cancellationToken);
                    slice.Restart();
                }
            }

            _classNamesComplete = true;
            await MarkAsync("pg:suggestions-ready");
        }
        catch (OperationCanceledException)
        {
            // Component disposed mid-build.
        }
    }

    private string[] Variants =>
        _variants ??= CommonVariants.Where(v => _displayFramework.TryValidateCandidate($"{v}:flex")).ToArray();

    private async Task RegisterCompletionProviderAsync()
    {
        await BlazorMonaco.Languages.Global.RegisterCompletionItemProvider(Js, "html",
            new CompletionItemProvider(CompletionTriggerCharacters, ProvideCompletionItemsAsync, ResolveCompletionItemAsync));
    }

    private async Task<CompletionList> ProvideCompletionItemsAsync(string uri, Position position, CompletionContext context)
    {
        // Nothing outside a class attribute, so Monaco's built-in HTML completions are untouched.
        var model = await Global.GetModel(Js, uri);
        var token = model is null ? null : await GetClassTokenAtPositionAsync(model, position);
        if (token is null)
        {
            return new CompletionList { Suggestions = [], Incomplete = false };
        }

        // Keep any variant chain (`md:dark:`) and complete only the utility after the last ':'.
        // The replace range is the whole token, so filtering sees `hover:bg-` and accepting
        // mid-token swaps the token instead of splicing into it; insert/filter text carry the
        // variant prefix to match.
        EnsureClassNamesBuilding();

        var typed = token.TypedPrefix;
        var colon = typed.LastIndexOf(':');
        var variantPrefix = typed[..(colon + 1)];
        var utilityPrefix = typed[(colon + 1)..];
        var range = token.ToRange(position.LineNumber);

        var suggestions = new List<CompletionItem>();
        var capped = false;

        // Variants first in the list when the typed segment starts one (`ho` -> hover:).
        if (utilityPrefix.Length > 0)
        {
            foreach (var variant in Variants)
            {
                if (variant.StartsWith(utilityPrefix, StringComparison.Ordinal))
                {
                    var text = $"{variantPrefix}{variant}:";
                    suggestions.Add(new CompletionItem
                    {
                        LabelAsString = text,
                        Kind = CompletionItemKind.Keyword,
                        Detail = "variant",
                        InsertText = text,
                        FilterText = text,
                        SortText = $"0{suggestions.Count:D4}",
                        RangeAsObject = range,
                        Command = new Command { Id = "editor.action.triggerSuggest", Title = "Suggest utilities" },
                    });
                }
            }
        }

        // Prefix matches in list order (p-2 before p-10), then — if there's room — classes where
        // the typed text starts a later segment (`red` -> bg-red-500), which Monaco's fuzzy
        // filter also accepts.
        foreach (var prefixPass in new[] { true, false })
        {
            if (!prefixPass && utilityPrefix.Length == 0)
            {
                break;
            }

            // Index loop: _classNames may still be growing (it can't change during this loop —
            // there's no await in it — but a foreach would also be wrong across requests).
            for (var i = 0; i < _classNames.Count; i++)
            {
                var name = _classNames[i];
                var matches = prefixPass
                    ? name.StartsWith(utilityPrefix, StringComparison.Ordinal)
                    : !name.StartsWith(utilityPrefix, StringComparison.Ordinal)
                      && name.Contains("-" + utilityPrefix, StringComparison.Ordinal);
                // At-rule utilities (@container) don't take variants.
                if (!matches || (variantPrefix.Length > 0 && name[0] == '@'))
                {
                    continue;
                }

                if (suggestions.Count >= MaxCompletionItems)
                {
                    capped = true;
                    break;
                }

                suggestions.Add(CreateUtilityItem(name, variantPrefix, range, suggestions.Count));
            }

            if (capped)
            {
                break;
            }
        }

        // Incomplete makes Monaco re-query on the next keystroke instead of filtering this page
        // client-side: needed when capped, and while the list is still being built.
        return new CompletionList { Suggestions = suggestions, Incomplete = capped || !_classNamesComplete };
    }

    private CompletionItem CreateUtilityItem(string name, string variantPrefix, BlazorMonaco.Range range, int order)
    {
        var text = variantPrefix + name;

        // Colour utilities get Monaco's swatch: it paints one when the detail is a hex colour.
        if (!_swatchCache.TryGetValue(name, out var hex))
        {
            hex = ColorSwatch.TryGetHex(name, _displayFramework.Settings.Theme);
            _swatchCache[name] = hex;
        }

        return new CompletionItem
        {
            LabelAsString = text,
            Kind = hex is null ? CompletionItemKind.Value : CompletionItemKind.Color,
            Detail = hex,
            InsertText = text,
            FilterText = text,
            SortText = $"1{order:D4}",
            RangeAsObject = range,
        };
    }

    // Monaco calls this for the focused item only: compile its CSS (variants included) then.
    private Task<CompletionItem> ResolveCompletionItemAsync(CompletionItem item)
    {
        var className = item.InsertText ?? item.LabelAsString;
        if (!string.IsNullOrEmpty(className) && !className.EndsWith(':'))
        {
            var css = CompileForDisplay(className);
            if (css is not null)
            {
                item.DocumentationAsObject = new MarkdownString { Value = $"```css\n{css}\n```", SupportThemeIcons = false };
            }
        }

        return Task.FromResult(item);
    }

    // ---- Monaco setup --------------------------------------------------------
    private static StandaloneEditorConstructionOptions StandardOptions() => new()
    {
        AutomaticLayout = true,
        GlyphMargin = false,
        Scrollbar = new EditorScrollbarOptions { HorizontalScrollbarSize = 8, VerticalScrollbarSize = 8 },
        RenderLineHighlight = "none",
        FontFamily = "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
        FontSize = 13,
        LineHeight = 21,
        ColorDecorators = true,
        Padding = new EditorPaddingOptions { Top = 10, Bottom = 10 },
        Hover = new EditorHoverOptions { Enabled = true, Delay = 200 },
        Minimap = new EditorMinimapOptions { Enabled = false },
        Contextmenu = false,
        Theme = "monorail-light",
    };

    private static StandaloneEditorConstructionOptions HtmlEditorOptions(StandaloneCodeEditor _)
    {
        var opts = StandardOptions();
        opts.Language = "html";

        // Let the hover and the suggest widget's CSS details pane escape the editor pane instead
        // of being clipped at its edge (the pane is only half the viewport wide).
        opts.FixedOverflowWidgets = true;
        return opts;
    }

    private static StandaloneEditorConstructionOptions CssViewerOptions(StandaloneCodeEditor _)
    {
        var opts = StandardOptions();
        opts.Language = "css";
        opts.ReadOnly = true;
        opts.ColorDecorators = false;
        return opts;
    }

    // Two brand-tinted Monaco themes; background transparent so the pane's base-* colour shows
    // through and the editor tracks the docs light/dark toggle.
    private async Task DefineThemesAsync()
    {
        await Global.DefineTheme(Js, "monorail-light", new StandaloneThemeData
        {
            Base = "vs",
            Inherit = true,
            Rules = [],
            Colors = new Dictionary<string, string>
            {
                ["editor.background"] = "#00000000",
                ["editorLineNumber.foreground"] = "#b8b2ab",
                ["editorLineNumber.activeForeground"] = "#6b645c",
                ["editorCursor.foreground"] = "#8a5a2b",
                ["editor.selectionBackground"] = "#e7d8c6",
            },
        });

        await Global.DefineTheme(Js, "monorail-dark", new StandaloneThemeData
        {
            Base = "vs-dark",
            Inherit = true,
            Rules = [],
            Colors = new Dictionary<string, string>
            {
                ["editor.background"] = "#00000000",
                ["editorLineNumber.foreground"] = "#4a453f",
                ["editorLineNumber.activeForeground"] = "#a39c93",
                ["editorCursor.foreground"] = "#d6a06a",
                ["editor.selectionBackground"] = "#3a3128",
            },
        });
    }

    public async ValueTask DisposeAsync()
    {
        // Stop the background autocomplete build, if it's still running.
        await _disposeCts.CancelAsync();
        _disposeCts.Dispose();

        // _selfRef is only created in OnAfterRenderAsync, which runs in the browser — never
        // during the server prerender. So its presence is our signal that JS is actually
        // available; skipping the call otherwise avoids "interop during static rendering".
        if (_selfRef is null)
        {
            return;
        }

        try
        {
            // Disconnect the theme MutationObserver before dropping the .NET ref it calls back into.
            await Js.InvokeVoidAsync("monorailPlayground.disposeTheme");
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone (page unloading) — nothing to clean up.
        }

        _selfRef.Dispose();
    }

    // ---- helpers -------------------------------------------------------------
    // User Timing marks (visible in DevTools' Performance panel and to perf tooling) for the
    // playground's milestones: first preview painted, autocomplete list ready.
    private async Task MarkAsync(string name) => await Js.InvokeVoidAsync("monorailPlayground.mark", name);

    private static string FormatBytes(int bytes) =>
        bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024.0:0.0} KB";

    // Show only the `@layer utilities` body in the hover / a lean view — strip the surrounding
    // theme scaffolding. Ported from tests/TryMonorail.
    private static string ExtractLayerContent(string css)
    {
        if (!css.Contains("@layer"))
        {
            return css;
        }

        var layerStart = css.IndexOf("@layer utilities", StringComparison.Ordinal);
        if (layerStart == -1)
        {
            return css;
        }

        var openBraceIndex = css.IndexOf('{', layerStart);
        if (openBraceIndex == -1)
        {
            return css;
        }

        var braceCount = 1;
        var closeBraceIndex = openBraceIndex + 1;
        while (closeBraceIndex < css.Length && braceCount > 0)
        {
            switch (css[closeBraceIndex])
            {
                case '{': braceCount++; break;
                case '}': braceCount--; break;
            }

            closeBraceIndex++;
        }

        if (braceCount != 0)
        {
            return css;
        }

        var content = css.Substring(openBraceIndex + 1, closeBraceIndex - openBraceIndex - 2);
        return RemoveCommonLeadingWhitespace(content);
    }

    private static string RemoveCommonLeadingWhitespace(string text)
    {
        var lines = text.Split(["\r\n", "\r", "\n"], StringSplitOptions.None);

        var minLeadingSpaces = int.MaxValue;
        foreach (var line in lines)
        {
            if (string.IsNullOrWhiteSpace(line))
            {
                continue;
            }

            var leadingSpaces = 0;
            foreach (var c in line)
            {
                if (c is ' ' or '\t')
                {
                    leadingSpaces++;
                }
                else
                {
                    break;
                }
            }

            minLeadingSpaces = Math.Min(minLeadingSpaces, leadingSpaces);
        }

        if (minLeadingSpaces is int.MaxValue or 0)
        {
            return text.Trim('\r', '\n');
        }

        var result = new StringBuilder();
        foreach (var line in lines)
        {
            if (string.IsNullOrWhiteSpace(line))
            {
                result.AppendLine();
            }
            else
            {
                result.AppendLine(line[Math.Min(minLeadingSpaces, line.Length)..]);
            }
        }

        return result.ToString().Trim('\r', '\n');
    }

